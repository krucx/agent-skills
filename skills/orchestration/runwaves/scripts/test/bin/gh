#!/usr/bin/env bash
# Test shim for the GitHub CLI: auth status fails when $FIX/gh-signed-out exists, repo view --json
# answers $FIX/repo.json (or fails with $FIX/no-repo); pr view <n> answers $FIX/pr-view-<n>.json, else $FIX/pr-view.json, pr merge records its args in
# $FIX/merge.args, api rules/branches answers $FIX/rules.json; pr list answers from $FIX/prs.json (default: no PRs), honouring
# --head <branch> and --jq <expr> like the real one.
set -euo pipefail
arg() { local want=$1; shift; while (($#)); do [[ $1 == "$want" ]] && { echo "$2"; return; }; shift; done; }
case "$1 ${2:-}" in
  "pr list")
    out=$(cat "$FIX/prs.json" 2>/dev/null || echo '[]')
    head=$(arg --head "$@")
    [[ -z $head ]] || out=$(jq -c --arg h "$head" 'map(select(.headRefName == $h))' <<<"$out")
    expr=$(arg --jq "$@")
    if [[ -n $expr ]]; then jq -r "$expr" <<<"$out"; else echo "$out"; fi ;;
  "pr view") if [[ " $* " == *" --json files "* ]]; then cat "$FIX/pr-files.json"
             elif [[ -f $FIX/pr-view-$3.json ]]; then cat "$FIX/pr-view-$3.json"; else cat "$FIX/pr-view.json"; fi ;;
  "pr diff") cat "$FIX/pr.diff" ;;
  "pr merge") echo "$*" >"$FIX/merge.args" ;;
  "auth status") [[ ! -f $FIX/gh-signed-out ]] || { echo "You are not logged in" >&2; exit 1; } ;;
  "repo view")
    if [[ " $* " == *defaultBranchRef* ]]; then   # preflight: $FIX/repo.json, default a repo allowing every method
      [[ ! -f $FIX/no-repo ]] || { echo "not a GitHub repository" >&2; exit 1; }
      cat "$FIX/repo.json" 2>/dev/null || echo '{"nameWithOwner":"acme/app","defaultBranchRef":{"name":"main"},"squashMergeAllowed":true,"mergeCommitAllowed":true,"rebaseMergeAllowed":true}'
    else echo acme/app; fi ;;
  "issue view") cat "$FIX/issue-$3.json" 2>/dev/null || cat "$FIX/epic.json" ;;
  "api repos/acme/app/issues/"*"/sub_issues") cat "$FIX/sub-issues.json" ;;
  "api repos/acme/app/rules/branches/"*) cat "$FIX/rules.json" 2>/dev/null || echo '[]' ;;
  *) echo "gh shim: unsupported: $*" >&2; exit 1 ;;
esac
