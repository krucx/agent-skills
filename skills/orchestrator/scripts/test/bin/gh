#!/usr/bin/env bash
# Test shim for the GitHub CLI: pr list answers from $FIX/prs.json (default: no PRs).
set -euo pipefail
[[ -z ${GH_LOG:-} ]] || echo "$*" >>"$GH_LOG"
case "$1 ${2:-}" in
  "pr list") cat "$FIX/prs.json" 2>/dev/null || echo '[]' ;;
  *) echo "gh shim: unsupported: $*" >&2; exit 1 ;;
esac
