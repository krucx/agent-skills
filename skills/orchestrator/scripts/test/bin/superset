#!/usr/bin/env bash
# Test shim for the Paradev CLI: answers from JSON fixtures in $FIX instead of a host.
#   $FIX/snapshot.json    superset snapshot --json
#   $FIX/workspaces.json  [{id, name, branch, tags}]; list filters by --tag, get by ID
#   $FIX/create-fail      when present, workspaces create fails with its text as the error
#   $FIX/create.json      what workspaces create prints (default: workspace w-new, session t-new)
#   $FIX/create.args      the arguments of the last workspaces create call, one per line
#   $FIX/no-agents-wait   when present, the CLI has no `agents wait` (an old CLI)
#   $FIX/agents-wait.log  one line per `agents wait` started: "<pid> <terminal>"
#   $FIX/pages.args       the arguments of the last pages publish call, one per line
#   $FIX/pages.log        one line per pages publish call, its --page value (or "-")
#   $FIX/no-panes-open    when present, the CLI has no `panes open`
#   $FIX/panes.args       the arguments of the last panes open call, one per line
#   $FIX/projects.json    superset projects list (default: [{id: p1, name: app}])
#   $FIX/agents.json      superset agents list (default: Claude and "Claude (auto)")
#   $FIX/signed-out       when present, auth whoami fails; $FIX/host-down: snapshot fails
#   $FIX/screens/<tid>    the text terminals read returns for terminal <tid>
set -euo pipefail
arg() { local want=$1; shift; while (($#)); do [[ $1 == "$want" ]] && { echo "$2"; return; }; shift; done; }
case "$1 ${2:-}" in
  "snapshot --json") [[ ! -f $FIX/host-down ]] || { echo "host not running" >&2; exit 1; }
    cat "$FIX/snapshot.json" 2>/dev/null || echo '{"workspaces":[]}' ;;
  "--version"*) echo "2.0.8" ;;
  "auth whoami") [[ ! -f $FIX/signed-out ]] || { echo "not signed in" >&2; exit 1; }
    echo '{"email":"me@acme.dev"}' ;;
  "projects list") cat "$FIX/projects.json" 2>/dev/null || echo '[{"id":"p1","name":"app"}]' ;;
  "agents list") cat "$FIX/agents.json" 2>/dev/null ||
    echo '[{"presetId":"claude","label":"Claude","command":"claude","args":[]},{"presetId":"claude-auto","label":"Claude (auto)","command":"claude","args":["--permission-mode","auto"]}]' ;;
  "workspaces list")
    jq -c --arg tag "$(arg --tag "$@")" \
      'map(select($tag == "" or ((.tags // "") | ascii_downcase) == ($tag | ascii_downcase)))' \
      "$FIX/workspaces.json" ;;
  "workspaces get") jq -ce --arg id "$3" '.[] | select(.id == $id)' "$FIX/workspaces.json" ;;
  "workspaces create")
    printf '%s\n' "$@" >"$FIX/create.args"
    [[ ! -f $FIX/create-fail ]] || { cat "$FIX/create-fail" >&2; exit 1; }
    if [[ -f $FIX/create.json ]]; then cat "$FIX/create.json"
    else jq -nc --arg b "$(arg --branch "$@")" '{id: "w-new", branch: $b, agents: [{sessionId: "t-new"}]}'; fi ;;
  "terminals read")
    f="$FIX/screens/$(arg --terminal "$@")"
    [[ -f $f ]] || { echo "terminal not found" >&2; exit 1; }
    max=$(arg --max-lines "$@")
    tail -n "${max:-1000}" "$f" | jq -Rsc '{text: .}' ;;
  "agents wait")
    [[ ! -f $FIX/no-agents-wait ]] || { echo "unknown command: agents wait" >&2; exit 1; }
    [[ " $* " == *" --help "* ]] && exit 0
    t=$(arg --terminal "$@"); limit=$(arg --timeout "$@")
    echo "$$ $t" >>"$FIX/agents-wait.log"
    for ((i = 0; i < ${limit:-600} * 10; i++)); do   # until the terminal's agent is not working
      jq -e --arg t "$t" '[.workspaces[].terminals[] | select(.id == $t and .agent.state != "working")] | length > 0' \
        "$FIX/snapshot.json" >/dev/null && exit 0
      sleep 0.1
    done
    exit 1 ;;
  "pages publish")
    printf '%s\n' "$@" >"$FIX/pages.args"
    echo "$(arg --page "$@")" | sed 's/^$/-/' >>"$FIX/pages.log"
    cp "$3" "$FIX/pages.html"
    jq -nc --arg id "$(arg --page "$@")" '{id: (if $id == "" then "page-1" else $id end), url: "https://pages.example/run"}' ;;
  "panes open")
    [[ ! -f $FIX/no-panes-open ]] || { echo "unknown command: panes open" >&2; exit 1; }
    [[ " $* " == *" --help "* ]] && exit 0
    printf '%s\n' "$@" >"$FIX/panes.args" ;;
  *) echo "superset shim: unsupported: $*" >&2; exit 1 ;;
esac
